###########
# HELPERS #
###########
# DOCKER BUILD
#  sudo docker buildx build --pull --no-cache --platform linux/amd64,linux/arm64 /mnt/storage/dockerfiles/mariadb-12.3-noble-auto-backups/ -t fsismo/mariadb-12.3-noble-auto-backups:latest -t fsismo/mariadb-12.3-noble-auto-backups:12.3.$(date +"%Y%m%d-%H%M") --push
# RUN
#  docker run --hostname mariadb --name mariadb-12.3-noble-auto-backups \
#   -e MARIADB_ROOT_PASSWORD=CHANGE_ME \
#   -e BACKUP_RETENTION=30 \
#   -v /opt/docker/apache-mariadb/mariadb/data:/var/lib/mysql \
#   -v /opt/docker/apache-mariadb/mariadb/dbbackups:/var/dbbackups  \
#   -p 3306:3306  \
#   -d \
#   fsismo/mariadb-12.3-noble-auto-backups
# IT BASH
#  docker container exec -u 0 -it mariadb-12.3-noble-auto-backups bash
# STOP and RESET
#  docker container stop mariadb-12.3-noble-auto-backups && docker container rm mariadb-12.3-noble-auto-backups


#########
# IMAGE #
#########
FROM  mariadb:12.3-noble

########################
# ENVIROMENT VARIABLES #
########################
ENV TZ=America/Argentina/Buenos_Aires
ARG DEBIAN_FRONTEND=noninteractive


############
# PACKAGES #
############
RUN apt-get update
RUN apt install cron -y

############
# MY STUFF #
############
COPY ./opt/dbbackup /opt/dbbackup
COPY ./opt/utils/services.sh /opt/utils/services.sh
COPY ./etc/cron.d/* /etc/cron.d/
RUN chmod +x /opt/dbbackup/*.sh
RUN chmod +x /opt/utils/services.sh
#RUN sed -i "s/\#\!\/bin\/bash/\#\!\/bin\/bash\n\/opt\/utils\/services.sh \> \/dev\/null 2\>\&1/" /usr/local/bin/docker-entrypoint.sh
RUN sed -i "s/shopt -s nullglob/shopt -s nullglob\n\/opt\/utils\/services.sh 3\>\&1 \> \/dev\/null 2\>\&1/" /usr/local/bin/docker-entrypoint.sh
#########
# PORTS #
#########
EXPOSE 3306

###########
# SERVICE #
###########
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["mariadbd"]
